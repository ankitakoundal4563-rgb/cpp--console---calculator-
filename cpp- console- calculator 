#include <iostream>
using namespace std;

class Calculator
 {
private:
    double formula;

public:
    double num1, num2;

    void setformula(double f)
 {
        formula = f;
    }
    
    double getformula() 
{
        return formula;  
    }

    void add(double a, double b) 
{
        formula = a + b;
        cout << a << "+" << b << "=" << formula << endl;
    }

    void sub(double a, double b) 
{
        formula = a - b;
        cout << a << "-" << b << "=" << formula << endl;
    }

    void mul(double a, double b)
 {
        formula = a * b;
        cout << a << "*" << b << "=" << formula << endl;
    }

    void div(double a, double b) {
        if(b == 0)
 {
            formula = a / b;
            cout << a << "/" << b << "=" << formula << endl;
        }
        else
 {
            cout << "Error : 0 se divide nahi hota!" << endl;
        }
    }
};

int main() {
    Calculator calc;
    calc.add(20, 10);
    calc.sub(20, 10);
    calc.mul(20, 10);
    calc.div(20, 10);
    calc.div(20, 0);  
    calc.setformula(100);
    return 0;
}